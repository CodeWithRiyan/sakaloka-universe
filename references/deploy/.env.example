# Copy this file on the server as:
#   .env.dev   .env.sit   .env.demo   .env.prod
# and set real values per environment.

# ---- image coordinates (picked up by docker-compose.yml) ----
REGISTRY=git.sakaloka.id
IMAGE_NAME=riyan/pos-damai-rust
IMAGE_TAG=dev            # dev | sit | demo | prod
HOST_PORT=3011           # host-side port published on 127.0.0.1
CONTAINER_PORT=5150
NETWORK=net-dev          # external docker network (net-dev / net-sit / net-demo / net-prod)

# ---- Loco runtime ----
LOCO_ENV=production
PORT=5150
DATABASE_URL=postgres://user:pass@db-host:5432/pos_damai_dev
JWT_SECRET=change-me
