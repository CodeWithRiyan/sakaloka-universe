# =============================================================
# Sakaloka-Universe — Server Environment Variables Template
#
# Copy to /opt/sakaloka/<env>/.env and fill in real values.
# NEVER commit the filled .env files to version control.
#
# Generate secrets with: openssl rand -base64 48
# =============================================================

# Environment name (dev | sit | demo | prod)
SAKALOKA_ENV=dev

# HS256 JWT signing secret (min 32 chars)
SAKALOKA_JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND

# SurrealDB credentials
SURREALDB_USER=root
SURREALDB_PASS=CHANGE_ME_STRONG_PASSWORD

# Qdrant API key
QDRANT_MASTER_KEY=CHANGE_ME_QDRANT_KEY

# Zenoh credentials
ZENOH_USER=earth
ZENOH_PASS=CHANGE_ME_ZENOH_PASSWORD

# Logging level (debug | info | warn | error)
RUST_LOG=info
