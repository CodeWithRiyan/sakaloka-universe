# Copy to .env.dev / .env.sit / .env.demo / .env.prod on the server.
# NEVER commit filled .env files to version control.
# Generate secrets: openssl rand -base64 48

# ── Image coordinates (used by docker-compose.yml) ───────────
REGISTRY=git.sakaloka.id
API_IMAGE=riyan/sakaloka-api
WEB_IMAGE=riyan/sakaloka-pos
IMAGE_TAG=dev
API_HOST_PORT=53000
WEB_HOST_PORT=53040
NETWORK=net-dev

# ── Application ──────────────────────────────────────────────
SAKALOKA_ENV=dev
SAKALOKA_JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND
DATABASE_URL=postgres://user:password@host:5432/sakaloka_db
CORS_ORIGINS=https://venus.sakaloka.id
RUST_LOG=info
