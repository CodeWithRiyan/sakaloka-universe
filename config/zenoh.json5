{
  // ============================================================
  // 🪐 Saturn (Zenoh) Configuration 
  // ============================================================
  
  mode: "router",
  
  // Node ID must be a 128-bit hex string
  id: "53414b414c4f4b4153415455524e3031", 

  listen: {
    endpoints: ["tcp/0.0.0.0:7447"]
  },

  transport: {
    auth: {
      usrpwd: {
        dictionary_file: "/zenoh-users.dict"
      }
    }
  },

  access_control: {
    enabled: true,
    default_permission: "deny",
    rules: [
      {
        id: "earth-all",
        key_exprs: ["sakaloka/earth/**", "sakaloka/jupiter/**"],
        permission: "allow",
        messages: ["put", "delete", "declare_subscriber", "query", "reply", "declare_queryable"]
      },
      {
        id: "jupiter-all",
        key_exprs: ["sakaloka/**"],
        permission: "allow",
        messages: ["put", "delete", "declare_subscriber", "query", "reply", "declare_queryable"]
      },
      {
        id: "neptune-all",
        key_exprs: ["sakaloka/jupiter/**", "sakaloka/neptune/**"],
        permission: "allow",
        messages: ["put", "declare_subscriber", "query", "reply"]
      }
    ],
    subjects: [
      {
        id: "earth-subj",
        usernames: ["earth"]
      },
      {
        id: "jupiter-subj",
        usernames: ["jupiter"]
      },
      {
        id: "neptune-subj",
        usernames: ["neptune"]
      }
    ],
    policies: [
      {
        rules: ["earth-all"],
        subjects: ["earth-subj"]
      },
      {
        rules: ["jupiter-all"],
        subjects: ["jupiter-subj"]
      },
      {
        rules: ["neptune-all"],
        subjects: ["neptune-subj"]
      }
    ]
  }
}
