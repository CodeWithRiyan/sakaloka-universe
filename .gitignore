# Rust build artifacts
/target/

# Environment secrets — NEVER commit
.env
.env.local
.env.*.local

# Cargo lock (keep for binaries, exclude for libs if desired)
# Cargo.lock

# macOS
.DS_Store
.__MACOSX

# IDE
.vscode/
.idea/
*.code-workspace

# Venus (Tauri + React) frontend — only src-tauri/ is tracked
apps/venus/*
!apps/venus/src-tauri/
!apps/venus/CLAUDE.md

# MdBook output
/docs/book/

# Model files (binary, usually large)
*.bin
*.onnx
*.pt

# Logs
*.log

# Temporary files
*.swp
*.bak

# code-review-graph
.code-review-graph/
