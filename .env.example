# =============================================================
# Sakaloka-Universe -- Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit the real .env to version control.
# =============================================================

# HS256 secret shared by all planets for JWT signing.
# Must be at least 32 characters. Generate with:
#   openssl rand -base64 48
SAKALOKA_JWT_SECRET=change-me-at-least-32-chars-long!

# PostgreSQL -- primary database (external infra)
DATABASE_URL=postgres://dev_user:eE4W2heguc8SX7VHu3gs@infra-dev-postgres:5432/sakaloka_db

# API runtime
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:1420

# Logging
RUST_LOG=info
