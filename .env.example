# =============================================================
# Sakaloka-Universe -- Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit the real .env to version control.
# =============================================================

# HS256 secret shared by all planets for JWT signing.
# Must be at least 32 characters. Generate with:
#   openssl rand -base64 48
SAKALOKA_JWT_SECRET=change-me-at-least-32-chars-long!

# Postgres (Earth) -- apps/api (Loco)
DATABASE_URL=postgres://sakaloka:sakaloka_dev@127.0.0.1:55432/sakaloka_dev
POSTGRES_DB=sakaloka_dev
POSTGRES_USER=sakaloka
POSTGRES_PASSWORD=sakaloka_dev

# Qdrant master API key (Uranus). Used by ApiKeyVault to issue scoped keys.
QDRANT_MASTER_KEY=change-me-qdrant-master-key

# Ockam vault secret (Mars). Used to seal the Ockam identity vault.
SAKALOKA_OCKAM_SECRET=change-me-ockam-vault-secret

# SurrealDB (Jupiter) -- libs/data
SURREALDB_URL=ws://127.0.0.1:58000
SURREALDB_USER=root
SURREALDB_PASS=sakaloka-dev

# Qdrant (Uranus) -- libs/data
QDRANT_URL=http://127.0.0.1:56333

# Zenoh (Saturn) -- libs/data
ZENOH_CONNECT=tcp/127.0.0.1:57447
ZENOH_USER=earth
ZENOH_PASS=Sakaloka123!

# Ockam (Mars) -- apps/ockam
OCKAM_PORT=4000

# Logging
RUST_LOG=info
