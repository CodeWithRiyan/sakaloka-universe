# Sakaloka-Universe environment variables — DEVELOPMENT DEFAULTS
# Copy this file to .env and fill in real secrets.
# NEVER commit .env to Git.

# ── JWT / IAM ─────────────────────────────────────────────────
# Minimum 32 characters. Used for all HS256 signing.
SAKALOKA_JWT_SECRET=change-me-to-a-secure-random-string-min-32-chars

# ── Ockam (Mars) ──────────────────────────────────────────────
SAKALOKA_OCKAM_SECRET=change-me-ockam-vault-secret

# ── SurrealDB (Jupiter) ───────────────────────────────────────
SURREALDB_USER=root
SURREALDB_PASS=sakaloka-dev-password

# ── Qdrant (Uranus) ───────────────────────────────────────────
QDRANT_MASTER_KEY=sakaloka-dev-qdrant-key
